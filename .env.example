# Copy this file to .env.local after creating a Supabase project and an OpenRouter API key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Never prefix this key with NEXT_PUBLIC_ or commit .env.local.
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_TRANSCRIPTION_MODEL=openai/gpt-4o-mini-transcribe
OPENROUTER_FEEDBACK_MODEL=openai/gpt-5-mini
